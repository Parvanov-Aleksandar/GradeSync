<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.ecp</groupId>
    <artifactId>GradeSync</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source> <!-- Recommend Java 17 LTS for stability -->
        <maven.compiler.target>17</maven.compiler.target> <!-- Ensure your JDK is 17 or newer -->
        <exec.mainClass>gradesync.Main</exec.mainClass> <!-- Updated for 'gradesync' package -->

        <!-- Define consistent versions for Google API client libraries -->
        <google.api.client.version>1.32.1</google.api.client.version>
        <google.api.services.classroom.version>v1-rev20250420-2.0.0</google.api.services.classroom.version>
        <google.auth.library.oauth2.http.version>1.35.0</google.auth.library.oauth2.http.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>${google.api.client.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-classroom</artifactId>
            <version>${google.api.services.classroom.version}</version>
        </dependency>

        <!-- ALTERNATIVE JSON PARSING: Using Gson instead of Jackson -->
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-gson</artifactId>
            <version>1.42.0</version>
            <type>jar</type>
        </dependency>

        <!-- THESE ARE ABSOLUTELY REQUIRED FOR DESKTOP APP OAUTH (Browser-based flow using LocalServerReceiver) -->
        <dependency>
            <groupId>com.google.oauth-client</groupId>
            <artifactId>google-oauth-client-java6</artifactId>
            <version>${google.api.client.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.oauth-client</groupId>
            <artifactId>google-oauth-client-jetty</artifactId>
            <version>${google.api.client.version}</version>
        </dependency>

        <!-- Your original dependency, kept as per your request.
             It's for different auth flows, not this desktop app quickstart one. -->
        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
            <version>${google.auth.library.oauth2.http.version}</version>
        </dependency>
    </dependencies>
</project>